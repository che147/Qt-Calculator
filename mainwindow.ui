  <property name="styleSheet">
   <string notr="true">/* ===== 计算器全局样式表 ===== */
QMainWindow {
    background-color: #f3f3f3;
}
QLabel#labelExpression {
    color: #8a8a8a;
    font-size: 12pt;
}
QLineEdit#lineEditDisplay {
    background: transparent;
    border: none;
    color: #1b1b1b;
    font-size: 30pt;
    font-weight: 600;
}
/* 数字键 */
QPushButton[buttonRole="digit"] {
    background-color: #ffffff;
    border: 1px solid #ececec;
    border-radius: 6px;
    font-size: 16pt;
    color: #1b1b1b;
}
QPushButton[buttonRole="digit"]:hover  { background-color: #f0f4ff; }
QPushButton[buttonRole="digit"]:pressed{ background-color: #dfe8ff; }
/* 功能键（C ⌫ % ±） */
QPushButton[buttonRole="func"] {
    background-color: #e9edf2;
    border: 1px solid #e0e4ea;
    border-radius: 6px;
    font-size: 15pt;
    color: #2b2b2b;
}
QPushButton[buttonRole="func"]:hover  { background-color: #dde3ec; }
QPushButton[buttonRole="func"]:pressed{ background-color: #ccd4e0; }
/* 运算符键（÷ × − +） */
QPushButton[buttonRole="op"] {
    background-color: #eef3fb;
    border: 1px solid #dfe8f5;
    border-radius: 6px;
    font-size: 17pt;
    color: #1a66d6;
}
QPushButton[buttonRole="op"]:hover  { background-color: #e0eaf9; }
QPushButton[buttonRole="op"]:pressed{ background-color: #cddcf3; }
/* 等号键 */
QPushButton[buttonRole="equals"] {
    background-color: #2f6fdb;
    border: none;
    border-radius: 6px;
    font-size: 17pt;
    color: #ffffff;
}
QPushButton[buttonRole="equals"]:hover  { background-color: #2a63c4; }
QPushButton[buttonRole="equals"]:pressed{ background-color: #2457ae; }</string>
